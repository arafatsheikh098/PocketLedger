{% extends "base.html.j2" %}
{% block title %}Import #{{ batch.id }} - PocketLedger{% endblock %}
{% block content %}
<h1>Import #{{ batch.id }}</h1>
<p>File: <code>{{ batch.filename }}</code> &middot; Created: {{ batch.created_at }} &middot; Rows: {{ batch.row_count }}{% if batch.undone %} &middot; <strong>undone</strong>{% endif %}</p>
{% if not batch.undone %}
<form method="post" action="/imports/{{ batch.id }}/undo" class="inline">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  <button type="submit" class="secondary" onclick="return confirm('Undo this import? All its rows will be deleted.')">Undo this import</button>
</form>
{% endif %}
<h2>Transactions</h2>
<table>
  <thead><tr><th>Date</th><th>Description</th><th>Amount</th></tr></thead>
  <tbody>
  {% for t in rows %}
    <tr>
      <td>{{ t.date }}</td>
      <td>{{ t.description }}</td>
      <td class="{% if t.amount_minor < 0 %}amount-expense{% elif t.amount_minor > 0 %}amount-income{% endif %}">{{ "%.2f"|format(t.amount_minor / 100) }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endblock %}
