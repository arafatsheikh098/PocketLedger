{% extends "base.html.j2" %}
{% block title %}Accounts - PocketLedger{% endblock %}
{% block content %}
<div class="page-header">
  <div>
    <h1>Accounts</h1>
    <div class="subtitle">Each account belongs to one of: bank, mobile wallet, cash, or card.</div>
  </div>
</div>

{% if error %}<div class="flash error">{{ error }}</div>{% endif %}

<table>
  <thead><tr>
    <th>Name</th>
    <th>Type</th>
    <th style="text-align:right">Transactions</th>
    <th></th>
  </tr></thead>
  <tbody>
  {% for a in accounts %}
    <tr>
      <td>
        <form method="post" action="/accounts/{{ a.id }}/rename" class="inline" style="display:flex;gap:0.5rem;align-items:center">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <input name="name" value="{{ a.name }}" maxlength="64" required style="max-width:240px">
          <button type="submit" class="secondary">Rename</button>
        </form>
      </td>
      <td><span class="badge muted">{{ a.type }}</span></td>
      <td style="text-align:right">{{ txn_counts.get(a.id, 0) }}</td>
      <td>
        <form method="post" action="/accounts/{{ a.id }}/delete" class="inline">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <button type="submit" class="secondary" onclick="return confirm('Delete account {{ a.name }}?')">Delete</button>
        </form>
      </td>
    </tr>
  {% else %}
    <tr><td colspan="4" class="muted">No accounts yet.</td></tr>
  {% endfor %}
  </tbody>
</table>

<h2>Add account</h2>
<form method="post" action="/accounts" class="filters" style="grid-template-columns: 2fr 1fr auto">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  <div class="row"><label>Name <input name="name" maxlength="64" required></label></div>
  <div class="row"><label>Type
    <select name="type" required>
      {% for t in account_types %}<option value="{{ t }}">{{ t }}</option>{% endfor %}
    </select>
  </label></div>
  <div class="row" style="display:flex;align-items:flex-end"><button type="submit">Create</button></div>
</form>
{% endblock %}