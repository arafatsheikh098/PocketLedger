{% extends "base.html.j2" %}
{% block title %}Accounts - PocketLedger{% endblock %}
{% block content %}
<h1>Accounts</h1>
{% if error %}<div class="flash error">{{ error }}</div>{% endif %}
<table>
  <thead><tr><th>Name</th><th>Type</th><th>Transactions</th><th></th></tr></thead>
  <tbody>
  {% for a in accounts %}
    <tr>
      <td>
        <form method="post" action="/accounts/{{ a.id }}/rename" class="inline">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <input name="name" value="{{ a.name }}" maxlength="64" required>
          <button type="submit" class="secondary">Rename</button>
        </form>
      </td>
      <td>{{ a.type }}</td>
      <td>{{ txn_counts.get(a.id, 0) }}</td>
      <td>
        <form method="post" action="/accounts/{{ a.id }}/delete" class="inline">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <button type="submit" class="secondary" onclick="return confirm('Delete account {{ a.name }}?')">Delete</button>
        </form>
      </td>
    </tr>
  {% else %}
    <tr><td colspan="4" class="muted">No accounts yet.</td></tr>
  {% endfor %}
  </tbody>
</table>
<h2>Add account</h2>
<form method="post" action="/accounts">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  <div class="row"><label>Name <input name="name" maxlength="64" required></label></div>
  <div class="row"><label>Type
    <select name="type" required>
      {% for t in account_types %}<option value="{{ t }}">{{ t }}</option>{% endfor %}
    </select>
  </label></div>
  <button type="submit">Create</button>
</form>
{% endblock %}
