{% extends "base.html.j2" %}
{% block title %}Change password - PocketLedger{% endblock %}
{% block content %}
<h1>Change password</h1>
{% if error %}<div class="flash error">{{ error }}</div>{% endif %}
<form method="post" action="/auth/change-password">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  <div class="row"><label>Current password <input name="current_password" type="password" required></label></div>
  <div class="row"><label>New password (min 8 chars) <input name="new_password" type="password" minlength="8" required></label></div>
  <button type="submit">Update</button>
</form>
{% endblock %}
