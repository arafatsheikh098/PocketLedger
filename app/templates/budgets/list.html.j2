{% extends "base.html.j2" %}
{% block title %}Budgets - PocketLedger{% endblock %}
{% block content %}
<div class="page-header">
  <div>
    <h1>Budgets</h1>
    <div class="subtitle">{{ month_str }} &middot; 80% lights up <span class="badge warn">warning</span>; 100% lights up <span class="badge over">over</span>. Transfers excluded.</div>
  </div>
</div>

{% if error %}<div class="flash error">{{ error }}</div>{% endif %}

<form method="get" action="/budgets" class="filters">
  <div class="row"><label>Month <input type="month" name="month" value="{{ month_str }}"></label></div>
  <div class="row" style="display:flex;align-items:flex-end"><button type="submit" class="secondary">Switch month</button></div>
</form>

<table>
  <thead>
    <tr>
      <th>Category</th>
      <th style="text-align:right">Budget</th>
      <th style="text-align:right">Spent</th>
      <th style="text-align:right">Remaining</th>
      <th style="text-align:right">%</th>
      <th>Status</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    {% for p in rows %}
      <tr class="row-{{ p.status }}">
        <td>{{ categories_by_id.get(p.budget.category_id, '?') }}</td>
        <td style="text-align:right">{{ "%.2f"|format(p.budget.amount_minor / 100) }}</td>
        <td style="text-align:right">{{ "%.2f"|format(p.spent_minor / 100) }}</td>
        <td style="text-align:right">{{ "%.2f"|format(p.remaining_minor / 100) }}</td>
        <td style="text-align:right">{{ p.pct }}%</td>
        <td>
          {% if p.status == "ok" %}<span class="badge ok">ok</span>
          {% elif p.status == "warning" %}<span class="badge warn">warning</span>
          {% else %}<span class="badge over">over</span>{% endif %}
        </td>
        <td>
          <form method="post" action="/budgets/{{ p.budget.id }}/delete" class="inline">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <button type="submit" class="secondary"
                    onclick="return confirm('Delete this budget?')">Delete</button>
          </form>
        </td>
      </tr>
    {% else %}
      <tr><td colspan="7" class="muted">No budgets for this month yet.</td></tr>
    {% endfor %}
  </tbody>
</table>

<h2>Set / update a budget</h2>
{% if categories %}
  <form method="post" action="/budgets" class="filters" style="grid-template-columns: 1fr 1fr 1fr auto">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <div class="row">
      <label>Category
        <select name="category_id" required>
          {% for c in categories %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}
        </select>
      </label>
    </div>
    <div class="row">
      <label>Month <input type="month" name="month" value="{{ month_str }}" required></label>
    </div>
    <div class="row">
      <label>Amount
        <input name="amount" required placeholder="e.g. 300.00">
      </label>
    </div>
    <div class="row" style="display:flex;align-items:flex-end"><button type="submit">Save</button></div>
  </form>
{% else %}
  <p class="muted">Create at least one category first.</p>
{% endif %}
{% endblock %}