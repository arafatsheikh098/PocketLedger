{% extends "base.html.j2" %}
{% block title %}Categories - PocketLedger{% endblock %}
{% block content %}
<div class="page-header">
  <div>
    <h1>Categories</h1>
    <div class="subtitle">Default categories are seeded on user creation and cannot be deleted.</div>
  </div>
</div>

{% if error %}<div class="flash error">{{ error }}</div>{% endif %}

<table>
  <thead><tr>
    <th>Name</th>
    <th>Default</th>
    <th style="text-align:right">Used in</th>
    <th></th>
  </tr></thead>
  <tbody>
  {% for c in categories %}
    <tr>
      <td>
        <form method="post" action="/categories/{{ c.id }}/rename" class="inline" style="display:flex;gap:0.5rem;align-items:center">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <input name="name" value="{{ c.name }}" maxlength="64" required style="max-width:240px">
          <button type="submit" class="secondary">Rename</button>
        </form>
      </td>
      <td>{% if c.is_default %}<span class="badge muted">default</span>{% else %}<span class="muted">—</span>{% endif %}</td>
      <td style="text-align:right">{{ usage.get(c.id, 0) }} transactions</td>
      <td>
        {% if not c.is_default %}
        <form method="post" action="/categories/{{ c.id }}/delete" class="inline">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <button type="submit" class="secondary" onclick="return confirm('Delete category {{ c.name }}?')">Delete</button>
        </form>
        {% endif %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<h2>Add category</h2>
<form method="post" action="/categories" class="filters" style="grid-template-columns: 2fr auto">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  <div class="row"><label>Name <input name="name" maxlength="64" required></label></div>
  <div class="row" style="display:flex;align-items:flex-end"><button type="submit">Create</button></div>
</form>
{% endblock %}