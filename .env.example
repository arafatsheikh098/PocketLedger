# PocketLedger environment configuration
# Copy to .env and adjust. All values shown are defaults baked into the app.

# Required in production. The app refuses to start with the default value.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-please-change-me-please-change-me-please-1234567890

# SQLite database file path. The container uses /data/pocketledger.db (volume).
DATABASE_URL=sqlite:///./pocketledger.db

# When true, self-registration is allowed via /auth/register.
ALLOW_REGISTRATION=false

# Demo mode shows the banner "Demo with fake data. Do not enter real data.".
DEMO_MODE=false

# Re-seed a deterministic demo user with 6 months of fake transactions on start.
SEED_ON_START=false

# IANA timezone string used for month boundaries. Default UTC.
USER_TIMEZONE=UTC

# Default currency seeded on user creation.
DEFAULT_CURRENCY=USD

# Max CSV upload size in bytes (default 5 MiB).
MAX_UPLOAD_BYTES=5242880

# Environment: "production" requires non-default SECRET_KEY. "development" allows defaults.
APP_ENV=development
